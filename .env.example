# ==============================================================================
# Environment Configuration Template
# Project: AI-Based Early Warning & Risk Monitoring for Landslide-Prone Areas
# Note: Copy this file to .env and configure local values. Do NOT commit .env to git.
# ==============================================================================

# Application Environment (development, staging, production, test)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend API Configuration
API_BASE_URL=http://localhost:8000
PORT=8000
SECRET_KEY=change_this_to_a_secure_random_secret_in_local_env

# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite+aiosqlite:///./landslide.db

# External Meteorological Services (Optional)
WEATHER_API_KEY=your_weather_api_key_placeholder

# Google Gemini API Key for Natural Language Advisories & Summarization (Optional)
GEMINI_API_KEY=your_gemini_api_key_placeholder
