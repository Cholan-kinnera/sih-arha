# Application Environment
PROJECT_NAME="Citizen Benefits Intelligence Platform API"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# Database Configuration (Async PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_this_password_in_local_env"
POSTGRES_DB="cbip_dev"
DATABASE_URL="postgresql+asyncpg://postgres:change_this_password_in_local_env@localhost:5432/cbip_dev"
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security (Placeholders only)
SECRET_KEY="change_this_secret_key_in_local_env_file_only"
ALLOWED_HOSTS=["*"]
