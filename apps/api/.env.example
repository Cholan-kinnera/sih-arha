# ==============================================================================
# LEWS Backend Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
PROJECT_NAME="Landslide Early Warning & Risk Monitoring API"
API_V1_STR=/api/v1

# Security & CORS
SECRET_KEY=replace_with_a_secure_random_hex_key_in_production
ALLOWED_HOSTS=*

# Database Connection (PostgreSQL with PostGIS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lews
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional direct database connection string (overrides POSTGRES_* parameters)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lews
# For isolated local unit testing without PostgreSQL:
# DATABASE_URL=sqlite:///./data/lews_dev.db
